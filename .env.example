# ─────────────────────────────────────────────────────────────
# AIMoniPoint — environment variables
# Copy to .env.local for local development, and add the same
# keys in Vercel → Project → Settings → Environment Variables.
# Never commit real keys.
# ─────────────────────────────────────────────────────────────

# Public site URL (used for canonical URLs, sitemap, OG images)
NEXT_PUBLIC_SITE_URL=https://aimonipoint.com

# Public contact details
NEXT_PUBLIC_CONTACT_EMAIL=hello@aimonipoint.com
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-handle/discovery-call

# ── Email (Resend) — contact, enquiry and lead-magnet forms ──
# Create a key at https://resend.com/api-keys and verify your domain.
RESEND_API_KEY=
# Must be on a domain verified in Resend
RESEND_FROM_EMAIL="AIMoniPoint <hello@aimonipoint.com>"
# Where form submissions are delivered
CONTACT_TO_EMAIL=you@example.com

# ── Newsletter ──────────────────────────────────────────────
# One of: convertkit | mailchimp | none
# "none" emails new sign-ups to CONTACT_TO_EMAIL instead.
NEWSLETTER_PROVIDER=none

# ConvertKit (Kit) — API v4 key and form ID
CONVERTKIT_API_KEY=
CONVERTKIT_FORM_ID=

# Mailchimp — API key (ends in -usXX) and audience/list ID
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=

# ── Analytics (loaded only after cookie consent) ────────────
# Set ONE of these, or leave both empty.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_GA_ID=

# ── Floating WhatsApp button ────────────────────────────────
# International format, digits only (e.g. 15551234567). Empty = hidden.
NEXT_PUBLIC_WHATSAPP_NUMBER=
